<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#39766D</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#F6F4EE</item>
    </style>
    <style name="ReaderDialogDay" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">#39766D</item>
    </style>
    <style name="ReaderDialogNight" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">#D0D0D0</item>
        <item name="android:colorBackground">#202020</item>
        <item name="android:windowBackground">#202020</item>
        <item name="android:textColorPrimary">#DDD8CE</item>
        <item name="android:textColorSecondary">#9C9C9C</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
